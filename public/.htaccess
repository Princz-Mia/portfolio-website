# Static hosting configuration for the exported site (Apache / LiteSpeed).
# Every route is a folder with an index.html, so no rewrites are needed.

AddDefaultCharset UTF-8
Options -Indexes

# Serve the exported not-found page with a real 404 status.
ErrorDocument 404 /404.html

# WebAssembly must be served with its own type so browsers can compile it
# while it streams (WebAssembly.instantiateStreaming).
AddType application/wasm .wasm

# The CV page's PDF renderer runs its worker from an .mjs file. Module workers
# only start when the file is served as JavaScript, and older hosts don't map .mjs.
AddType text/javascript .mjs

# The CV opens in the browser's PDF viewer (which has its own download button)
# instead of downloading straight away; a saved copy takes its name from the URL.
AddType application/pdf .pdf
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set Content-Disposition "inline"
  </FilesMatch>
</IfModule>

# The social preview image is exported without a file extension.
<Files "opengraph-image">
  ForceType image/png
</Files>

# Fonts are immutable; HTML must always be revalidated.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The game engine in /doom/ is large and rarely changes, but its file name is
  # not fingerprinted: cache it for 30 days and revalidate after that.
  <FilesMatch "\.wasm$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml application/wasm
</IfModule>
