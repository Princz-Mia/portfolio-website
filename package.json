{
  "name": "portfolio-website",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio of Mia Princz, exported as a static site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/preview.mjs",
